{
  "name": "ccl-requests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test \"src/**/*.test.js\" \"supabase/tests/**/*.test.js\" \"worker/**/*.test.js\" \"tools/**/*.test.mjs\"",
    "preview": "vite preview",
    "test:spin:db": "node --test supabase/tests/dailySpin.test.js",
    "test:daily:db": "node --test supabase/tests/dailyRewards.test.js",
    "test:comments:db": "node --test supabase/tests/commentsReplies.test.js",
    "test:question-bank": "node --test tools/question-bank.test.mjs",
    "question-bank:validate": "node tools/validate-question-bank.mjs",
    "test:migrate": "node --test tools/migration-safety.test.mjs",
    "test:migration:db": "node --test supabase/tests/migrationDeploy.test.js",
    "test:migration:pglite": "node --test supabase/tests/voteCalendarDecoupling.pglite.mjs",
    "test:free-votes:pglite": "node --test supabase/tests/dailyFreeVotes.pglite.mjs",
    "test:ledger:pglite": "node --test supabase/tests/rewardLedger.pglite.mjs",
    "test:mystery:pglite": "node --test supabase/tests/mysteryBox.pglite.mjs",
    "test:spinv2:pglite": "node --test supabase/tests/spinV2.pglite.mjs",
    "test:baseline:db": "node --test supabase/tests/baselineReadiness.test.js",
    "backup:db": "bash scripts/backup-db.sh",
    "backup:verify": "bash scripts/verify-backup.sh",
    "db:check": "node tools/migrate.mjs --check",
    "db:verify-baseline": "node tools/migrate.mjs --verify",
    "db:plan": "node tools/migrate.mjs --plan",
    "db:deploy": "node tools/migrate.mjs --apply",
    "db:baseline:snapshot": "node tools/schema-readiness.mjs --write",
    "smoke": "node tools/smoke.mjs",
    "schema:split": "node scripts/split-schema.mjs --write",
    "schema:split:check": "node scripts/split-schema.mjs --check",
    "test:quiz-off:db": "node --test supabase/tests/quizRuntimeDisabled.test.js"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@supabase/supabase-js": "^2.109.0",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.1.0",
    "oxlint": "^1.79.0",
    "pg": "^8.23.0",
    "vite": "^8.2.2"
  }
}
