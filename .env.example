# =========================================================
#  Copy file nay thanh  .env  roi dien thong tin that vao
#  Lay o: Supabase → Project Settings → API Keys
# =========================================================

VITE_SUPABASE_URL=https://yooxntqwdlvkxcblgqbw.supabase.co

# Khoa cong khai. Project tao tu cuoi 2025 tro di se co dang:
VITE_SUPABASE_ANON_KEY=sb_publishable_4jGXNIjGvToqfcTCMGVP-g_u0FYOhdt
# Project cu hon thi la mot chuoi JWT dai bat dau bang eyJ... (van dung duoc)
# Ca hai loai deu dan vao dong tren, khong can doi ten bien.
#
# TUYET DOI KHONG dung khoa "secret" (sb_secret_...) hay "service_role" o day —
# no bo qua moi quy tac bao mat va se lo ra trinh duyet.

# --- CLOUDFLARE TURNSTILE CAPTCHA ---
# Lay Site Key tu Cloudflare Dashboard → Turnstile. Secret Key cau hinh
# o Supabase Dashboard → Authentication → Attack Protection.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEpBV9cZ6WCH2Gsg

# --- LA CHAN O EDGE (tuy chon) -----------------------------------------------
# Duong chinh thuc: Cloudflare Pages Functions — functions/api/* goi lai logic
# worker/index.js (xem HUONG-DAN.md, muc "La chan Edge"). Khi da bat, luot quay
# / luot vote di qua Turnstile + KV check fingerprint/IP truoc khi cham Supabase.
# Chi dien hai bien duoi SAU KHI GET /api/daily-spin/health tren domain that da
# tra JSON {"ok":true,...} — dien som la hong nut Spin/Vote ngay lap tuc, vi app
# se goi vao cong chua ton tai:
# VITE_SPIN_GATE_URL=/api/daily-spin
# VITE_VOTE_GATE_URL=/api/vote
# Bo trong (vd deploy Vercel khong co cong Edge): Spin/Vote goi thang RPC nhu
# cu — van gui fp_hash de han muc theo van tay trong Postgres hoat dong.
# KV + secret (SPIN_SHIELD, TURNSTILE_SECRET_KEY, SUPABASE_ANON_KEY) dat tren
# Pages Dashboard → Settings, nho dat cho ca Production lan Preview — khong
# dat o file nay, khong commit secret.
#
# Muon CHAN HAN loi goi thang PostgREST (bat buoc moi thu di qua cong Edge):
#   1. Pages Dashboard → Settings → Environment variables: them secret
#      EDGE_GATE_TOKEN (chuoi ngau nhien >= 32 ky tu) cho ca Production lan
#      Preview, roi deploy lai de cong nhan token.
#   2. Supabase SQL Editor: select public.set_edge_gate_token('dung chuoi do');
# Lam nguoc thu tu (bat token o DB truoc khi cong co token) se khoa ca nguoi
# that. Tat khan cap bat cu luc nao: select public.set_edge_gate_token(null);

# --- KENH YOUTUBE (khong bat buoc) -----------------------------------------
# Handle nay duoc dung de lay cac video moi nhat tren kenh, khong phai du lieu
# video nhap tay. Dien channel ID UC... neu YouTube khong cho doc trang handle.
# VITE_YOUTUBE_CHANNEL_HANDLE=Chaereve
# VITE_YOUTUBE_CHANNEL_ID=UCHztIyDNlLlZ6JA85a6BdCw

# --- TUY CHON: day anh dai dien len Cloudinary thay vi luu trong database ---
# Bo trong = anh duoc thu nho con 128px roi luu thang vao profiles.avatar_url
# (~5-9KB moi nguoi, khong ton o Storage nao cua Supabase).
# VITE_CLOUDINARY_CLOUD=ten_cloud_cua_ban
# VITE_CLOUDINARY_PRESET=ten_unsigned_upload_preset
