<?xml version="1.0" encoding="UTF-8"?>
<!-- =========================================================
  sitemap.xml — chaereve.pages.dev
  ---------------------------------------------------------
  Gồm các route SPA trong src/App.jsx, trang tĩnh public/, và route archive
  được server-render bởi functions/archive.js. Thêm route công khai thì phải
  cập nhật sitemap cùng hợp đồng SEO test để Google biết đường mới tồn tại.

  <lastmod> là ngày sửa thật của sitemap, không phải ngày deploy — ghi bừa
  ngày mới mỗi lần build là dạy Google bỏ qua cột này.
  ========================================================= -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- Bảng yêu cầu: nội dung đổi liên tục (request mới, vote mới) và là
       trang duy nhất có nội dung thật cho crawler chưa đăng nhập. -->
  <url>
    <loc>https://chaereve.pages.dev/</loc>
    <lastmod>2026-09-18</lastmod>
    <changefreq>hourly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Điểm danh và quiz: mỗi tính năng có trang riêng; thưởng cần đăng nhập. -->
  <url>
    <loc>https://chaereve.pages.dev/daily-login</loc>
    <lastmod>2026-10-03</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://chaereve.pages.dev/quiz</loc>
    <lastmod>2026-10-03</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.5</priority>
  </url>

  <!-- Vòng quay thưởng: nội dung tĩnh, chỉ số dư là của riêng người dùng. -->
  <url>
    <loc>https://chaereve.pages.dev/daily-spin</loc>
    <lastmod>2026-09-18</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>

  <!-- Bảng xếp hạng: đổi theo vote nên đáng quay lại, nhưng không gấp
       bằng bảng chính. -->
  <url>
    <loc>https://chaereve.pages.dev/ranking</loc>
    <lastmod>2026-09-18</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- "Của tôi": trang CÁ NHÂN, chưa đăng nhập thì crawler chỉ thấy cổng
       đăng nhập. Vẫn khai vì nằm trong ROUTES, nhưng priority thấp nhất —
       nếu sau này thấy Google lập chỉ mục nó thành trang rỗng thì xoá
       khối này và thêm `Disallow: /profile` vào robots.txt. -->
  <url>
    <loc>https://chaereve.pages.dev/profile</loc>
    <lastmod>2026-09-18</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.3</priority>
  </url>

  <!-- FAQ: trang TĨNH trong public/ (không phải route SPA) — nội dung HTML
       thật, là thứ crawler chưa đăng nhập đọc được nhiều nhất sau bảng chính.
       seoContract.test.js biết trang này qua STATIC_ROUTES. -->
  <url>
    <loc>https://chaereve.pages.dev/faq.html</loc>
    <lastmod>2026-09-29</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- Archive: HTML được render phía Pages Function, có VideoObject JSON-LD
       lấy từ các request completed thật; không cần cron hay bản sao dữ liệu. -->
  <url>
    <loc>https://chaereve.pages.dev/archive</loc>
    <lastmod>2026-09-29</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>

</urlset>
