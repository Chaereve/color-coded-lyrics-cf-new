{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "overrides": [
    {
      "files": [
        "worker/**/*.js",
        "functions/**/*.js"
      ],
      "env": {
        "worker": true,
        "browser": false
      }
    },
    {
      "files": [
        "**/*.test.js",
        "**/*.test.mjs",
        "**/*.pglite.mjs",
        "supabase/tests/**/*.js",
        "tools/**/*.mjs",
        "scripts/**/*.mjs",
        "vite.config.js"
      ],
      "env": {
        "node": true,
        "browser": true
      }
    },
    {
      "files": [
        "src/lib/*.jsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
