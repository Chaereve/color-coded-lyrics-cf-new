{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "color-coded-lyrics",
  "compatibility_date": "2026-01-01",

  // =========================================================
  //  LƯU Ý ĐƯỜNG DEPLOY (2026-09-08): file này KHÔNG PHẢI đường production.
  //  Production là Cloudflare Pages (chaereve.pages.dev, nối GitHub, tự
  //  build `npm run build` khi push). Lá chắn Edge chạy ở đó bằng
  //  **Pages Functions**: functions/api/daily-spin/{health,spin}.js và
  //  functions/api/vote/cast.js — lớp vỏ mỏng gọi lại đúng các hàm trong
  //  worker/index.js, nên hai đường dùng chung một logic.
  //  File wrangler.jsonc này chỉ còn là PHƯƠNG ÁN THAY THẾ: ai muốn chạy bằng
  //  Workers with Static Assets (`wrangler deploy`) thì vẫn dùng được, vì
  //  export default fetch() trong worker/index.js gọi chung các hàm route đó.
  //  D1/KV binding khai ở đây KHÔNG tự sang Pages — Pages phải bind riêng trên
  //  Dashboard (xem HUONG-DAN.md, mục "Lá chắn Edge").
  // =========================================================

  // Worker cổng: /api/daily-spin/* đi vào lá chắn Edge (worker/index.js),
  // mọi đường dẫn còn lại vẫn trả file tĩnh của app như cũ.
  "main": "worker/index.js",

  "assets": {
    "directory": "./dist",

    // SPA: mọi đường dẫn không khớp file nào đều trả về index.html
    "not_found_handling": "single-page-application"
  },

  // === LÁ CHẮN EDGE: DAILY SPIN + VOTE (Workers fallback) ===
  // D1 là backend ưu tiên cho bộ đếm chống farm, thay trần 1.000 KV writes/ngày.
  // Production Pages cần binding `RATE_SHIELD` trên Dashboard; Workers deploy
  // bằng CLI cần tạo D1 rồi bật block d1_databases mẫu bên dưới.
  // KV `SPIN_SHIELD` chỉ giữ làm fallback trong rollout/môi trường cũ.
  // Thiết lập D1 một lần:
  //   npx wrangler d1 create ccl-rate-shield
  //   npx wrangler d1 execute ccl-rate-shield --remote --file=worker/migrations/0001_rate_shield.sql
  // Dán database_id trả về vào cấu hình mẫu rồi deploy. Production Pages thì
  // tạo database/áp migration tương tự, sau đó thêm D1 binding RATE_SHIELD trong Dashboard.
  // "d1_databases": [
  //   { "binding": "RATE_SHIELD", "database_name": "ccl-rate-shield", "database_id": "<ID-thật>" }
  // ],
  //
  // KV cũ chỉ dùng nếu chưa gắn D1 trong lúc rollout:
  // "kv_namespaces": [
  //   { "binding": "SPIN_SHIELD", "id": "<ID-KV-thật>" }
  // ],
  //
  // Secret (không bao giờ commit):
  //   wrangler secret put TURNSTILE_SECRET_KEY
  //   wrangler secret put SUPABASE_ANON_KEY
  //   wrangler secret put EDGE_GATE_TOKEN (tuỳ chọn, khóa direct RPC)
  // SUPABASE_URL không phải bí mật nên nằm trong [vars] bên dưới.
  // Chỉ cấu hình VITE_SPIN_GATE_URL=/api/daily-spin và VITE_VOTE_GATE_URL=/api/vote
  // SAU khi health trả {"ok":true,"shield":true,...}; sau đó mới bật EDGE_GATE_TOKEN
  // ở Postgres bằng set_edge_gate_token('<token>'). Tắt khẩn cấp bằng null.

  "vars": {
    // Giống VITE_SUPABASE_URL trong .env của frontend
    "SUPABASE_URL": "https://yooxntqwdlvkxcblgqbw.supabase.co"
  },

  "observability": {
    "enabled": true
  }
}
